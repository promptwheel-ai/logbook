  ],
  "bin": {
    "logbook-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=18.14.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@promptwheel/logbook": "^0.9.10",
    "zod": "^3.23.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptwheel-ai/logbook.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/promptwheel-ai/logbook/tree/master/mcp#readme",
  "bugs": "https://github.com/promptwheel-ai/logbook/issues",
  "scripts": {
    "test": "node --test test/server.test.mjs",
    "release": "node scripts/shrinkwrap.mjs && npm publish && node scripts/shrinkwrap.mjs --clean",
    "release:dry": "node scripts/shrinkwrap.mjs && npm publish --dry-run && node scripts/shrinkwrap.mjs --clean"
