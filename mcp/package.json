{
  "name": "@promptwheel/logbook-mcp",
  "mcpName": "io.github.promptwheel-ai/logbook",
  "version": "0.6.2",
  "description": "Git-history memory for coding agents: reverts, weakened tests, hot spots, and unreviewed notes.",
